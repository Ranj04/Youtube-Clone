# Database Configuration
# Supports multiple formats for compatibility with Railway and other platforms

# Option 1: Individual variables (Railway MySQL format)
MYSQLHOST=localhost
MYSQLUSER=root
MYSQLPASSWORD=your_secure_password_here
MYSQLDATABASE=youtube_clone
MYSQLPORT=3306

# Option 2: Alternative variable names (also supported)
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=your_secure_password_here
# MYSQL_DATABASE=youtube_clone
# MYSQL_PORT=3306

# Option 3: Connection string (Railway provides this automatically)
# MYSQL_URL=mysql://user:password@host:port/database
# DATABASE_URL=mysql://user:password@host:port/database

# Application Configuration
NODE_ENV=development
PORT=3000

# Railway automatically sets:
# - PORT (for the web server)
# - RAILWAY_ENVIRONMENT
# - All MySQL variables when you add a MySQL service
