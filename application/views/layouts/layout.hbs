<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="YouTube Clone - Share and discover amazing videos">
    <title>{{title}} | YouTube Clone</title>
    <link rel="icon" href="/public/favicon.ico" sizes="70x70" type="image/ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel='stylesheet' href='/public/css/style.css' />
  </head>
  <body>
    <header>
      <h1>YouTube Clone</h1>
    </header>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/posts">Videos</a></li>
        {{#if username}}
          <li><a href="/posts/create">Post Video</a></li>
          <li><a href="/users/logout">Logout ({{username}})</a></li>
        {{else}}
          <li><a href="/users/login">Login</a></li>
          <li><a href="/users/register">Register</a></li>
        {{/if}}
      </ul>
    </nav>
    <main>
      {{{body}}}
    </main>
    <footer>
      <p>&copy; 2025 YouTube Clone. Built with Node.js & Express.</p>
    </footer>
  </body>
</html>
